MODEL_PROVIDER=demo
# 接真实 OpenAI 兼容接口时设置：
# MODEL_PROVIDER=openai_compatible
# MODEL_API_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=your-key
# MODEL_NAME=your-model

# 原生 Anthropic Messages 协议：
# MODEL_PROVIDER=anthropic
# MODEL_API_BASE_URL=https://api.anthropic.com/v1
# MODEL_API_KEY=your-anthropic-key
# MODEL_NAME=your-claude-model

# 单次模型输出上限（256–8192，默认 2048）：
# MODEL_MAX_OUTPUT_TOKENS=4096

# 多模型目录可选；JSON 文件只保存环境变量名，不保存密钥。
# MODEL_CATALOG_PATH=./models.json

# 本地 stdio MCP 服务器目录（仅在会话明确授权后暴露工具）：
# MCP_SERVERS_PATH=./mcp-servers.json

# 显式加载本地可信 Python 插件配置：
# LOCAL_PLUGINS_PATH=./examples/plugins.json
